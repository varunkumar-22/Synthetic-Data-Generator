{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "engine": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "main:app"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "engine",
          "format": "url",
          "env": "PYTHON_SERVICE_URL"
        }
      ]
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
